---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareLinkGuard from '../../components/shared/ShareLinkGuard.vue';
import BlessingPage from '../../modules/blessing/BlessingPage.vue';
import festivals from '../../data/festivals.json';

export function getStaticPaths() {
  return festivals.map((f: any) => ({
    params: { festival: f.id },
    props: { festivalId: f.id },
  }));
}

const { festivalId } = Astro.props;
---

<BaseLayout title="七夕祝福">
  <ShareLinkGuard client:load page-type="blessing">
    <BlessingPage client:load :festivalId="festivalId" />
  </ShareLinkGuard>
</BaseLayout>
